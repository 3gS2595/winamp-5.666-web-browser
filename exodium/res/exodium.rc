// Resources built into gen_browser.dll.
#include <winres.h>

#include "resource.h"

// The skins of the ornaments on a browser window's corners (src\corner_skins.h), each
// picture drawn for the top right corner. Iron: the piece with the buttons for the top
// right one, and the same piece without them for the others.
IDR_CORNER_ORNAMENT RCDATA "corner_ornament.png"
IDR_CORNER_ORNAMENT_PLAIN RCDATA "corner_ornament_plain.png"
// Venom: a piece of its own for each corner. sources\venom.png is what they were cut from.
IDR_CORNER_VENOM_TOP_RIGHT RCDATA "corner_venom_top_right.png"
IDR_CORNER_VENOM_TOP_LEFT RCDATA "corner_venom_top_left.png"
IDR_CORNER_VENOM_BOTTOM_RIGHT RCDATA "corner_venom_bottom_right.png"
IDR_CORNER_VENOM_BOTTOM_LEFT RCDATA "corner_venom_bottom_left.png"
// Charms and Dark Charms: the same pieces in two finishes, cut from sources\charms.png and
// sources\darkcharms.png.
IDR_CORNER_CHARMS_TOP_RIGHT RCDATA "corner_charms_top_right.png"
IDR_CORNER_CHARMS_TOP_LEFT RCDATA "corner_charms_top_left.png"
IDR_CORNER_CHARMS_BOTTOM_RIGHT RCDATA "corner_charms_bottom_right.png"
IDR_CORNER_CHARMS_BOTTOM_LEFT RCDATA "corner_charms_bottom_left.png"
IDR_CORNER_DARKCHARMS_TOP_RIGHT RCDATA "corner_darkcharms_top_right.png"
IDR_CORNER_DARKCHARMS_TOP_LEFT RCDATA "corner_darkcharms_top_left.png"
IDR_CORNER_DARKCHARMS_BOTTOM_RIGHT RCDATA "corner_darkcharms_bottom_right.png"
IDR_CORNER_DARKCHARMS_BOTTOM_LEFT RCDATA "corner_darkcharms_bottom_left.png"

// Exodium's page in Winamp's Preferences (src\settings_page.cpp). Winamp puts it in the
// space its own pages take, which is this size, and they have the same style and font.
// The home page and the search share a box, its rows 14 or 15 units apart. The checkboxes
// go down the Options box 12 units apart, above the note at its foot, and the corners'
// skin and the glow have a box of their own below. The page is full: the two newest
// checkboxes share a row with a short one each, on its right.
IDD_PREFS DIALOGEX 0, 0, 272, 246
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    GROUPBOX        "Exodium",IDC_STATIC,0,0,272,246
    GROUPBOX        "Home Page and Search",IDC_STATIC,5,9,260,56
    LTEXT           "New windows and tabs open on:",IDC_STATIC,12,21,118,8
    EDITTEXT        IDC_PREFS_HOME_PAGE,132,19,126,12,ES_AUTOHSCROLL
    LTEXT           "Address bar searches go to:",IDC_STATIC,12,36,118,8
    COMBOBOX        IDC_PREFS_SEARCH_ENGINE,132,34,126,150,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Its address, %s for the words:",IDC_STATIC,12,50,118,8
    EDITTEXT        IDC_PREFS_SEARCH_URL,132,48,126,12,ES_AUTOHSCROLL
    GROUPBOX        "Options",IDC_STATIC,5,68,260,90
    CONTROL         "Reopen the windows that were open when Winamp closed",IDC_PREFS_RESTORE_WINDOWS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,79,246,10
    CONTROL         "Show close buttons on tabs",IDC_PREFS_TAB_CLOSE_BUTTONS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,91,124,10
    CONTROL         "Bitwarden password manager",IDC_PREFS_BITWARDEN,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,140,91,118,10
    CONTROL         "Ctrl+N in Winamp opens a new Exodium window",IDC_PREFS_CTRL_N_IN_WINAMP,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,103,246,10
    CONTROL         "Show Exodium in the Start menu",IDC_PREFS_START_MENU,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,115,124,10
    CONTROL         "Put unused tabs to sleep",IDC_PREFS_SLEEP_TABS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,140,115,118,10
    CONTROL         "Winamp's visualizers show page sound while Winamp is stopped",IDC_PREFS_SOUND_IN_VISUALIZERS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,127,246,10
    LTEXT           "",IDC_PREFS_START_MENU_NOTE,12,138,246,16
    GROUPBOX        "Looks",IDC_STATIC,5,162,260,80
    LTEXT           "Corner ornaments:",IDC_STATIC,12,175,64,8
    COMBOBOX        IDC_PREFS_CORNER_SKIN,78,173,100,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Glow round:",IDC_STATIC,12,191,64,8
    COMBOBOX        IDC_PREFS_GLOW,78,189,84,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "",IDC_PREFS_GLOW_SWATCH,"Static",SS_NOTIFY | WS_BORDER,166,190,12,12
    PUSHBUTTON      "Color...",IDC_PREFS_GLOW_COLOR,182,188,38,14
    PUSHBUTTON      "Default",IDC_PREFS_GLOW_DEFAULT,222,188,36,14
    CONTROL         "Always, not only while Winamp is in front",IDC_PREFS_GLOW_ALWAYS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,78,205,180,10
    LTEXT           "",IDC_PREFS_GLOW_SIZE_TEXT,12,219,80,8
    LTEXT           "",IDC_PREFS_GLOW_OPACITY_TEXT,96,219,80,8
    LTEXT           "",IDC_PREFS_GLOW_SPREAD_TEXT,180,219,78,8
    CONTROL         "",IDC_PREFS_GLOW_SIZE,"msctls_trackbar32",TBS_NOTICKS | WS_TABSTOP,8,228,84,12
    CONTROL         "",IDC_PREFS_GLOW_OPACITY,"msctls_trackbar32",TBS_NOTICKS | WS_TABSTOP,92,228,84,12
    CONTROL         "",IDC_PREFS_GLOW_SPREAD,"msctls_trackbar32",TBS_NOTICKS | WS_TABSTOP,176,228,84,12
END
