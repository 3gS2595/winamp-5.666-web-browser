#include "resource.h"
#include <winres.h>

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

// A folder's view in the library: like ml_playlists' own Playlists view (IDD_VIEW_PLAYLISTS),
// its list above, its buttons below. The library skins it all; the sizes are only a start,
// the view lays itself out (view.cpp).
IDD_FOLDER_VIEW DIALOGEX 0, 0, 184, 266
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD | WS_CLIPSIBLINGS | WS_CLIPCHILDREN
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL "", IDC_LIST, "SysListView32", LVS_REPORT | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | LVS_SHAREIMAGELISTS | WS_TABSTOP, 0, 0, 182, 253
    CONTROL "Play", IDC_PLAY, "Button", BS_OWNERDRAW | WS_TABSTOP, 0, 255, 22, 11
    CONTROL "Enqueue", IDC_ENQUEUE, "Button", BS_OWNERDRAW | WS_TABSTOP, 24, 255, 36, 11
    CONTROL "New Folder", IDC_NEWFOLDER, "Button", BS_OWNERDRAW | WS_TABSTOP, 62, 255, 44, 11
    LTEXT "", IDC_STATUS, 110, 256, 74, 9, SS_ENDELLIPSIS | SS_NOPREFIX
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEOS 0x40004L
 FILETYPE 0x2L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Playlist Folders for Winamp's Media Library"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "ml_playlist_folders"
            VALUE "OriginalFilename", "ml_playlist_folders.dll"
            VALUE "ProductName", "Playlist Folders"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
