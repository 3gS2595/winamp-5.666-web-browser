root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,h}]
indent_style = space
indent_size = 4

[*.{vcxproj,props,slnx,filters,config}]
indent_style = space
indent_size = 2

[exodium/third_party/**]
trim_trailing_whitespace = false
insert_final_newline = false
